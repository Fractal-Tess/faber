{
  "name": "@faber/runtime-sdk",
  "version": "0.2.0",
  "description": "JavaScript/TypeScript SDK for Faber secure task execution runtime",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
